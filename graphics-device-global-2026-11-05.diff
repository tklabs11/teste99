+    if (device_global != nullptr) {
+        device_global->device_token = 0;
+    }
+    if (state == nullptr || graphics_globals == nullptr || device_global == nullptr
+            || graphics_globals->device_window_token == 0) {
+        return D3DERR_INVALIDCALL;
+    }
+
+    state->device_token = 0;
+    const HRESULT result = SporeTranslatedCreateDeviceFromWindowGlobal(
+        state,
+        graphics_globals,
+        window,
+        host_presentation_out,
+        d3d9_out,
+        device_out);
+    if (SUCCEEDED(result) && *device_out != nullptr) {
+        device_global->device_token = state->device_token;
+        SDL_Log(
+            "TRANSLATED_STAGE FUN_011f8680 device-global=PASS "
+            "address=0x%08x guest-device=0x%08x",
+            kSporeGuestD3DDeviceGlobalAddress,
+            device_global->device_token);
+    }
+    return result;
+}

Incremental source diff for the device-global / FUN_0075f030 width-copy round.
This builds on the token-to-device registry and guest-memory bridge from the
preceding graphics-device-global increment; it is not a cumulative diff of the
project's pre-existing changes. README and phone logs are maintained separately.

diff --git a/app/src/main/cpp/spore_translated_graphics.h b/app/src/main/cpp/spore_translated_graphics.h
--- a/app/src/main/cpp/spore_translated_graphics.h
+++ b/app/src/main/cpp/spore_translated_graphics.h
@@ -66,9 +66,11 @@ public:
     HRESULT Present(
         std::uint32_t guest_token,
         const SporeGuestFrameOwner32* frame_owner) const;
+    std::uint64_t PresentDispatchCount() const;
 
 private:
     mutable std::mutex mutex_;
     std::uint32_t guest_token_ = 0;
     IDirect3DDevice9* device_ = nullptr;
+    mutable std::uint64_t present_dispatch_count_ = 0;
 };
@@ -92,2 +92,5 @@ bool SporeTranslatedSetDeviceWindowGlobal(
     SporeGuestMemory32* memory,
     std::uint32_t guest_window_token);
+bool SporeTranslatedSetCreateDeviceBackBufferWidth(
+    SporeGuestD3D9State32* state,
+    std::uint32_t guest_width);

diff --git a/app/src/main/cpp/spore_translated_graphics.cpp b/app/src/main/cpp/spore_translated_graphics.cpp
--- a/app/src/main/cpp/spore_translated_graphics.cpp
+++ b/app/src/main/cpp/spore_translated_graphics.cpp
@@ -158,5 +158,12 @@ HRESULT SporeNativeDeviceRegistry::Present(
     if (guest_token_ != guest_token || device_ == nullptr) {
         return D3DERR_INVALIDCALL;
     }
+    ++present_dispatch_count_;
     return device_->Present(nullptr, nullptr, nullptr, nullptr);
 }
+
+std::uint64_t SporeNativeDeviceRegistry::PresentDispatchCount() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return present_dispatch_count_;
+}
+
@@ -198,3 +198,17 @@ bool SporeTranslatedSetDeviceWindowGlobal(
     return memory->Write32(
         kSporeGuestDeviceWindowGlobalAddress, guest_window_token);
 }
+
+bool SporeTranslatedSetCreateDeviceBackBufferWidth(
+    SporeGuestD3D9State32* state,
+    std::uint32_t guest_width) {
+    if (state == nullptr) {
+        return false;
+    }
+
+    state->presentation.back_buffer_width = guest_width;
+    SDL_Log(
+        "TRANSLATED_STAGE FUN_0075f030 backbuffer-width=PASS width=%u",
+        guest_width);
+    return true;
+}

